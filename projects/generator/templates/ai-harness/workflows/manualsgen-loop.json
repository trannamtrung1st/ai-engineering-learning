{
  "loop": {
    "maxIterations": 80,
    "commitOnPass": true
  },
  "agent": {
    "timeoutMs": 3600000,
    "idleTimeoutMs": 300000,
    "shellTimeoutMs": 900000,
    "signalGraceMs": 15000,
    "resultGraceMs": 5000
  },
  "signals": {
    "complete": "MANUALSGEN_COMPLETE",
    "itemDone": "MANUALSGEN_DONE",
    "itemBlocked": "MANUALSGEN_BLOCKED"
  },
  "regeneration": {
    "mode": "incremental"
  },
  "implementationGate": {
    "mode": "optional",
    "requireAllSlicesPass": false
  },
  "validation": {
    "outputPathPrefix": "docs/user-manuals/",
    "minLines": {
      "module": 35,
      "flow": 40,
      "runbook": 50,
      "accounts": 25
    },
    "requiredHeadings": {
      "module": [
        "Purpose",
        "Who can use this",
        "How to get there",
        "Common tasks",
        "Troubleshooting"
      ],
      "flow": [
        "Goal",
        "Prerequisites",
        "Demo steps",
        "Expected results",
        "Recovery"
      ],
      "runbook": [
        "Audience",
        "Duration",
        "Ordered demo agenda",
        "Role/account cheat sheet"
      ],
      "accounts": [
        "Preview stack",
        "Login accounts",
        "Production first admin"
      ]
    },
    "flowIdPattern": "^FLOW-[0-9]{2}$"
  }
}
