{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attendly.local/ai-harness/schemas/ui-ux-suite.schema.json",
  "title": "HarnessCommonUiUxSuite",
  "description": "Generic, product-wide UI/UX suite executed by the browser tester on every full verification pass, against every distinct screen. Not tied to a requirement tag.",
  "type": "object",
  "required": ["suiteId", "version", "cases"],
  "additionalProperties": false,
  "properties": {
    "suiteId": { "type": "string", "const": "ui-ux-common" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/suiteCase" }
    }
  },
  "$defs": {
    "suiteCase": {
      "type": "object",
      "required": [
        "id",
        "category",
        "layer",
        "technique",
        "priority",
        "title",
        "steps",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^TC-UX-COMMON-[0-9]{3}$" },
        "category": { "type": "string", "const": "ui-ux" },
        "layer": { "type": "string", "const": "browser" },
        "technique": {
          "type": "string",
          "enum": [
            "ui-accessibility",
            "ui-responsive",
            "ui-visual-state",
            "ui-form-ux",
            "ui-navigation"
          ]
        },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "checklistRef": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "Item numbers in docs/ui-visual-verification.md this case derives from"
        },
        "title": { "type": "string", "minLength": 1 },
        "appliesTo": {
          "type": "string",
          "description": "Human-readable scope hint (e.g. 'every authenticated screen', 'every form')"
        },
        "preconditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "expected": { "type": "string", "minLength": 1 }
      }
    }
  }
}
