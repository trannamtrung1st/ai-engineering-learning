{
  "name": "@attendly/web",
  "version": "0.1.0",
  "private": true,
  "description": "Attendly web client — React + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "prebuild": "npm run build -w @attendly/domain --if-present",
    "preview": "vite preview",
    "typecheck": "npm run build -w @attendly/domain && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "npm run build -w @attendly/domain && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@attendly/domain": "*",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@attendly/config": "*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
